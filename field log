import React, { useState, useEffect, useRef } from "react";

const getToday = () => {
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};

const formatDate = (d) =>
  new Date(d + "T12:00:00").toLocaleDateString("en-US", {
    weekday: "long", month: "long", day: "numeric",
  });

const formatShort = (d) =>
  new Date(d + "T12:00:00").toLocaleDateString("en-US", {
    month: "short", day: "numeric",
  });

const GOALS = {
  doors: 10000,
  doorsDeadline: "2026-06-22",
  sales: 257,
  salesDeadline: "2026-08-28",
  startDate: "2026-05-03",
};

const DAILY_TARGETS = { doors: 200, sales: 2.2 };

function daysUntil(dateStr) {
  const target = new Date(dateStr + "T00:00:00");
  const now = new Date();
  now.setHours(0, 0, 0, 0);
  return Math.max(0, Math.ceil((target - now) / 86400000));
}

function daysSince(dateStr) {
  const start = new Date(dateStr + "T00:00:00");
  const now = new Date();
  now.setHours(0, 0, 0, 0);
  return Math.max(1, Math.ceil((now - start) / 86400000));
}

function ProgressBar({ value, max, color, height = 12 }) {
  const pct = Math.min(100, max > 0 ? (value / max) * 100 : 0);
  return (
    <div style={{ background: "#e0d5bf", borderRadius: 999, height, overflow: "hidden" }}>
      <div style={{
        width: `${pct}%`, height: "100%",
        background: `linear-gradient(90deg, ${color}bb, ${color})`,
        borderRadius: 999, transition: "width 1s ease",
        minWidth: pct > 0 ? 6 : 0,
      }} />
    </div>
  );
}

function StatCard({ label, value, sub, color, accent }) {
  return (
    <div style={{
      background: "#fdf8f0",
      border: "1.5px solid #d4c4a0",
      borderTop: `3px solid ${accent || color}`,
      borderRadius: 10,
      padding: "14px 14px 12px",
      flex: 1, minWidth: 0,
      boxShadow: "0 1px 4px rgba(0,0,0,0.06)",
    }}>
      <div style={{ fontSize: 22, fontWeight: 700, color, fontFamily: "'Oswald', sans-serif", lineHeight: 1.1 }}>{value}</div>
      <div style={{ fontSize: 10, color: "#7a6545", textTransform: "uppercase", letterSpacing: "0.1em", marginTop: 4 }}>{label}</div>
      {sub && <div style={{ fontSize: 11, color: "#a08060", marginTop: 3 }}>{sub}</div>}
    </div>
  );
}

