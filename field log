                          −
                        </button>

                        {/* Input */}
                        <input
                          type="number"
                          inputMode="decimal"
                          value={form[key]}
                          onChange={e => setForm(p => ({ ...p, [key]: e.target.value }))}
                          placeholder={isCurrency ? "0.00" : "0"}
                          style={{
                            flex: 1, minWidth: 0, boxSizing: "border-box",
                            padding: "10px 12px", borderRadius: 9,
                            border: `1.5px solid ${val > 0 ? C.green + "99" : C.border}`,
                            background: val > 0 ? "#f5fbf7" : "#fff",
                            fontSize: 22, color: C.text, outline: "none",
                            fontFamily: "Oswald, sans-serif", fontWeight: 600,
                            textAlign: "center",
                            transition: "all 0.2s",
                          }}
                        />

                        {/* Plus */}
                        <button
                          onClick={() => adjust(step)}
                          style={BtnStyle("plus")}
                          onMouseDown={e => { e.currentTarget.style.transform = "scale(0.92)"; e.currentTarget.style.boxShadow = "0 1px 4px rgba(36,61,46,0.2)"; }}
                          onMouseUp={e => { e.currentTarget.style.transform = "scale(1)"; e.currentTarget.style.boxShadow = "0 3px 8px rgba(36,61,46,0.30)"; }}
                          onTouchStart={e => { e.currentTarget.style.transform = "scale(0.92)"; }}
                          onTouchEnd={e => { e.currentTarget.style.transform = "scale(1)"; }}
                        >
                          +
                        </button>
                      </div>
                    )}

                    {target && val > 0 && (
                      <div style={{ marginTop: 8 }}>
                        <ProgressBar value={val} max={target} color={over ? C.green : C.gold} height={7} />
                        <div style={{ fontSize: 11, color: over ? C.green : C.muted, marginTop: 4, fontWeight: over ? 700 : 400 }}>
                          {over ? `✓ ${pct}% — target crushed!` : `${pct}% of daily target`}
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}

              <button onClick={save} style={{
                width: "100%", padding: "13px", borderRadius: 9, border: "none",
                background: saveState === "saved" ? C.green : C.greenDark,
                color: "#f5eedc", fontFamily: "Oswald, sans-serif", fontWeight: 700,
                fontSize: 16, letterSpacing: "0.1em", cursor: "pointer",
                transition: "all 0.3s", marginTop: 4,
                boxShadow: "0 3px 10px rgba(36,61,46,0.35)",
              }}>
                {saveState === "saving" ? "SAVING..." : saveState === "saved" ? "✓  LOGGED" : "SAVE TODAY'S LOG"}
              </button>
            </div>

            {/* Quick Summer Snapshot */}
            {daysWorked > 0 && (
              <>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 12, color: C.muted, letterSpacing: "0.1em", textTransform: "uppercase", marginBottom: 10 }}>
                  Summer Snapshot
                </div>
                <div style={{ display: "flex", gap: 10, marginBottom: 10 }}>
                  <StatCard label="Total Doors" value={totals.doors.toLocaleString()} sub={`${Math.round((totals.doors / GOALS.doors) * 100)}% to 10k`} color={C.green} accent={C.green} />
                  <StatCard label="Total Sales" value={totals.sales} sub={`${Math.round((totals.sales / GOALS.sales) * 100)}% to 257`} color={C.gold} accent={C.gold} />
                  <StatCard label="Revenue" value={`$${totals.revenue >= 1000 ? (totals.revenue / 1000).toFixed(1) + "k" : totals.revenue}`} color={C.brown} accent={C.brown} />
                </div>

                {/* Pace indicators */}
                <div style={{ display: "flex", gap: 10 }}>
                  <div style={{
                    flex: 1, padding: "10px 14px", borderRadius: 9,
                    background: doorsPace >= 0 ? "#e8f5ed" : "#fdecea",
                    border: `1.5px solid ${doorsPace >= 0 ? "#a8d5b8" : "#f5b7b1"}`,
                    fontSize: 12, color: doorsPace >= 0 ? C.green : C.behind,
                  }}>
                    <span style={{ fontFamily: "Oswald, sans-serif", fontWeight: 700, fontSize: 14 }}>
                      {doorsPace >= 0 ? "▲" : "▼"} {Math.abs(Math.round(doorsPace))}
                    </span>
                    <span style={{ marginLeft: 6 }}>doors {doorsPace >= 0 ? "ahead" : "behind"} pace</span>
                  </div>
                  <div style={{
                    flex: 1, padding: "10px 14px", borderRadius: 9,
                    background: salesPace >= 0 ? "#e8f5ed" : "#fdecea",
                    border: `1.5px solid ${salesPace >= 0 ? "#a8d5b8" : "#f5b7b1"}`,
                    fontSize: 12, color: salesPace >= 0 ? C.green : C.behind,
                  }}>
                    <span style={{ fontFamily: "Oswald, sans-serif", fontWeight: 700, fontSize: 14 }}>
                      {salesPace >= 0 ? "▲" : "▼"} {Math.abs(salesPace.toFixed(1))}
                    </span>
                    <span style={{ marginLeft: 6 }}>sales {salesPace >= 0 ? "ahead" : "behind"} pace</span>
                  </div>
                </div>
              </>
            )}
          </>
        )}

        {/* ══════════ SUMMER TAB ══════════ */}
        {tab === "summer" && (
          <>
            <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 14, color: C.muted, letterSpacing: "0.1em", textTransform: "uppercase", marginBottom: 16 }}>
              Summer 2026 · {daysWorked} days worked
            </div>

            {/* Doors Goal */}
            <div style={{ background: C.card, border: `1.5px solid ${C.border}`, borderRadius: 14, padding: 20, marginBottom: 12, boxShadow: "0 2px 8px rgba(0,0,0,0.07)" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
                <div>
                  <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 12, color: C.muted, letterSpacing: "0.1em", textTransform: "uppercase" }}>🚪 Doors Knocked</div>
                  <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 34, fontWeight: 700, color: C.greenDark, lineHeight: 1.1, marginTop: 4 }}>
                    {totals.doors.toLocaleString()}
                    <span style={{ fontSize: 16, color: C.muted, fontWeight: 400 }}> / 10,000</span>
                  </div>
                </div>
                <div style={{ textAlign: "right", flexShrink: 0 }}>
                  <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 26, fontWeight: 700, color: daysLeftDoors <= 14 ? C.behind : C.gold }}>
                    {daysLeftDoors}
                  </div>
                  <div style={{ fontSize: 11, color: C.muted }}>days left</div>
                  <div style={{ fontSize: 10, color: C.muted, marginTop: 2 }}>Jun 22 deadline</div>
                </div>
              </div>
              <ProgressBar value={totals.doors} max={GOALS.doors} color={C.green} height={16} />
              <div style={{ display: "flex", justifyContent: "space-between", marginTop: 8 }}>
                <span style={{ fontSize: 12, color: C.green, fontWeight: 700 }}>{Math.round((totals.doors / GOALS.doors) * 100)}% complete</span>
                <span style={{ fontSize: 12, color: C.muted }}>Need {doorsPerDay}/day to finish</span>
              </div>
              {daysWorked > 0 && (
                <div style={{
                  marginTop: 10, padding: "8px 12px", borderRadius: 8,
                  background: doorsPace >= 0 ? "#e8f5ed" : "#fdecea",
                  fontSize: 12, color: doorsPace >= 0 ? C.green : C.behind, fontWeight: 600,
                }}>
                  {doorsPace >= 0
                    ? `▲ ${Math.abs(Math.round(doorsPace))} doors ahead of schedule`
                    : `▼ ${Math.abs(Math.round(doorsPace))} doors behind schedule`}
                </div>
              )}
            </div>

            {/* Sales Goal */}
            <div style={{ background: C.card, border: `1.5px solid ${C.border}`, borderRadius: 14, padding: 20, marginBottom: 12, boxShadow: "0 2px 8px rgba(0,0,0,0.07)" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
                <div>
                  <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 12, color: C.muted, letterSpacing: "0.1em", textTransform: "uppercase" }}>✅ Sales Closed</div>
                  <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 34, fontWeight: 700, color: C.greenDark, lineHeight: 1.1, marginTop: 4 }}>
                    {totals.sales}
                    <span style={{ fontSize: 16, color: C.muted, fontWeight: 400 }}> / 257</span>
                  </div>
                </div>
                <div style={{ textAlign: "right", flexShrink: 0 }}>
                  <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 26, fontWeight: 700, color: daysLeftSales <= 14 ? C.behind : C.gold }}>
                    {daysLeftSales}
                  </div>
                  <div style={{ fontSize: 11, color: C.muted }}>days left</div>
                  <div style={{ fontSize: 10, color: C.muted, marginTop: 2 }}>Aug 28 deadline</div>
                </div>
              </div>
              <ProgressBar value={totals.sales} max={GOALS.sales} color={C.gold} height={16} />
              <div style={{ display: "flex", justifyContent: "space-between", marginTop: 8 }}>
                <span style={{ fontSize: 12, color: C.gold, fontWeight: 700 }}>{Math.round((totals.sales / GOALS.sales) * 100)}% complete</span>
                <span style={{ fontSize: 12, color: C.muted }}>Need {salesPerDay}/day to finish</span>
              </div>
              {daysWorked > 0 && (
                <div style={{
                  marginTop: 10, padding: "8px 12px", borderRadius: 8,
                  background: salesPace >= 0 ? "#e8f5ed" : "#fdecea",
                  fontSize: 12, color: salesPace >= 0 ? C.green : C.behind, fontWeight: 600,
                }}>
                  {salesPace >= 0
                    ? `▲ ${Math.abs(salesPace.toFixed(1))} sales ahead of schedule`
                    : `▼ ${Math.abs(salesPace.toFixed(1))} sales behind schedule`}
                </div>
              )}
            </div>

            {/* Stats Grid */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 12 }}>
              <StatCard label="Days Worked" value={daysWorked} color={C.greenDark} accent={C.green} />
              <StatCard label="Total Revenue" value={`$${totals.revenue.toLocaleString()}`} color={C.brown} accent={C.gold} />
              <StatCard
                label="Avg Doors / Day"
                value={daysWorked > 0 ? Math.round(totals.doors / daysWorked) : "—"}
                sub="target: 111"
                color={daysWorked > 0 && Math.round(totals.doors / daysWorked) >= 111 ? C.green : C.gold}
                accent={C.green}
              />
              <StatCard
                label="Avg Sales / Day"
                value={daysWorked > 0 ? (totals.sales / daysWorked).toFixed(1) : "—"}
                sub="target: 2.2"
                color={daysWorked > 0 && totals.sales / daysWorked >= 2.2 ? C.green : C.gold}
                accent={C.gold}
              />
              {revPerSale && (
                <StatCard label="Revenue / Sale" value={`$${revPerSale}`} color={C.brown} accent={C.brown} />
              )}
              <StatCard label="Total Pitches" value={totals.pitches} color={C.greenMid} accent={C.greenMid} />
            </div>

            {/* Conversion Funnel */}
            {totals.doors > 0 && (
              <div style={{ background: C.card, border: `1.5px solid ${C.border}`, borderRadius: 14, padding: 20, marginBottom: 12, boxShadow: "0 2px 8px rgba(0,0,0,0.07)" }}>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 14, fontWeight: 600, color: C.greenDark, letterSpacing: "0.08em", marginBottom: 16 }}>
                  CONVERSION FUNNEL
                </div>
                {[
                  { label: "Door → Answer",   rate: answerRate, num: totals.answers, den: totals.doors },
                  { label: "Answer → Pitch",   rate: pitchRate,  num: totals.pitches, den: totals.answers },
                  { label: "Pitch → Buying Q",  rate: bqRate,     num: totals.bq,      den: totals.pitches },
                  { label: "Buying Q → Sale",   rate: closeRate,  num: totals.sales,   den: totals.bq },
                ].map(({ label, rate, num, den }) => (
                  <div key={label} style={{ marginBottom: 14 }}>
                    <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 5 }}>
                      <span style={{ fontSize: 13, fontWeight: 700, color: C.text }}>{label}</span>
                      <span style={{ fontSize: 12, color: C.muted }}>
                        {num} / {den} = <strong style={{ color: C.green }}>{rate ? `${rate}%` : "—"}</strong>
                      </span>
                    </div>
                    <ProgressBar value={num} max={Math.max(den, 1)} color={C.greenMid} height={9} />
                  </div>
                ))}
                {revPerSale && (
                  <div style={{ marginTop: 10, padding: "10px 14px", background: "#f0f7f3", borderRadius: 8, fontSize: 13, color: C.greenDark, fontWeight: 600 }}>
                    💰 Avg contract value: ${revPerSale} &nbsp;·&nbsp; Total revenue: ${totals.revenue.toLocaleString()}
                  </div>
                )}
              </div>
            )}

            {/* History Table */}
            {sortedDays.length > 0 ? (
              <div style={{ background: C.card, border: `1.5px solid ${C.border}`, borderRadius: 14, padding: 20, boxShadow: "0 2px 8px rgba(0,0,0,0.07)" }}>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 14, fontWeight: 600, color: C.greenDark, letterSpacing: "0.08em", marginBottom: 4 }}>
                  RECENT DAYS
                </div>
                <div style={{ fontSize: 11, color: C.muted, marginBottom: 12 }}>Tap any row to edit</div>

                {/* Edit panel */}
                {editDay && (
                  <div style={{ background: "#f0f7f3", border: `1.5px solid ${C.green}55`, borderRadius: 10, padding: 16, marginBottom: 14 }}>
                    <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 13, color: C.greenDark, fontWeight: 700, marginBottom: 12, letterSpacing: "0.06em" }}>
                      ✏️ EDITING — {formatShort(editDay)}
                    </div>
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8, marginBottom: 12 }}>
                      {[
                        { key: "doors", label: "Doors" },
                        { key: "answers", label: "Answers" },
                        { key: "pitches", label: "Pitches" },
                        { key: "sales", label: "Sales" },
                        { key: "bq", label: "Buying Qs" },
                        { key: "revenue", label: "Revenue $" },
                      ].map(({ key, label }) => (
                        <div key={key}>
                          <div style={{ fontSize: 10, color: C.muted, textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: 3 }}>{label}</div>
                          <input
                            type="number"
                            value={editForm[key] ?? ""}
                            onChange={e => setEditForm(p => ({ ...p, [key]: e.target.value }))}
                            style={{
                              width: "100%", boxSizing: "border-box", padding: "7px 8px",
                              borderRadius: 6, border: `1.5px solid ${C.border}`,
                              fontSize: 15, fontFamily: "Oswald, sans-serif", fontWeight: 600,
                              color: C.text, background: "#fff", outline: "none", textAlign: "center",
                            }}
                          />
                        </div>
                      ))}
                    </div>
                    <div style={{ display: "flex", gap: 8 }}>
                      <button onClick={async () => {
                        const updated = { ...allDays[editDay], ...editForm };
                        if (window.storage) {
                          try { await window.storage.set(`day:${editDay}`, JSON.stringify(updated)); } catch (_) {}
                        }
                        setAllDays(prev => ({ ...prev, [editDay]: updated }));
                        setEditDay(null);
                        setEditForm({});
                      }} style={{
                        flex: 1, padding: "10px", borderRadius: 8, border: "none",
                        background: C.greenDark, color: "#f5eedc",
                        fontFamily: "Oswald, sans-serif", fontWeight: 700, fontSize: 14,
                        letterSpacing: "0.08em", cursor: "pointer",
                      }}>SAVE CHANGES</button>
                      <button onClick={() => { setEditDay(null); setEditForm({}); }} style={{
                        padding: "10px 16px", borderRadius: 8, border: `1.5px solid ${C.border}`,
                        background: "#fff", color: C.muted, fontFamily: "Oswald, sans-serif",
                        fontWeight: 600, fontSize: 14, cursor: "pointer",
                      }}>CANCEL</button>
                    </div>
                  </div>
                )}

                <div style={{ overflowX: "auto" }}>
                  <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 12 }}>
                    <thead>
                      <tr style={{ borderBottom: `2px solid ${C.border}` }}>
                        {["Date", "Doors", "Ans", "Pitch", "Sales", "BQ", "Rev"].map(h => (
                          <th key={h} style={{ padding: "4px 8px", textAlign: h === "Date" ? "left" : "right", color: C.muted, fontWeight: 700, textTransform: "uppercase", fontSize: 10, letterSpacing: "0.08em" }}>{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {sortedDays.map((date, i) => {
                        const d = allDays[date];
                        const isToday = date === todayKey;
                        const isEditing = date === editDay;
                        return (
                          <tr key={date} onClick={() => {
                            setEditDay(date);
                            setEditForm({ ...d });
                          }} style={{
                            borderBottom: `1px solid ${C.border}`,
                            background: isEditing ? "#e8f5ed" : isToday ? "#edf7f1" : i % 2 === 0 ? "transparent" : "#faf6ed",
                            cursor: "pointer",
                          }}>
                            <td style={{ padding: "8px 8px", color: isEditing ? C.green : isToday ? C.green : C.muted, fontWeight: isToday || isEditing ? 700 : 400, whiteSpace: "nowrap" }}>
                              {formatShort(date)}{isToday ? " ★" : ""}{isEditing ? " ✏️" : ""}
                            </td>
                            <td style={{ padding: "8px 8px", textAlign: "right", fontWeight: 700, color: C.green }}>{d.doors || 0}</td>
                            <td style={{ padding: "8px 8px", textAlign: "right", color: C.text }}>{d.answers || 0}</td>
                            <td style={{ padding: "8px 8px", textAlign: "right", color: C.text }}>{d.pitches || 0}</td>
                            <td style={{ padding: "8px 8px", textAlign: "right", fontWeight: 700, color: C.gold }}>{d.sales || 0}</td>
                            <td style={{ padding: "8px 8px", textAlign: "right", color: C.greenMid, fontWeight: 600 }}>{d.bq || 0}</td>
                            <td style={{ padding: "8px 8px", textAlign: "right", color: C.brown }}>${Number(d.revenue || 0).toLocaleString()}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </div>
            ) : (
              <div style={{ textAlign: "center", padding: "50px 20px", color: C.muted }}>
                <div style={{ fontSize: 32, marginBottom: 12 }}>🚪</div>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 18, letterSpacing: "0.08em" }}>NO DATA YET</div>
                <div style={{ fontSize: 13, marginTop: 6 }}>Log your first day in the Daily tab.</div>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  );
}
